{
  "name": "@acentric-llm/providers",
  "version": "0.0.0",
  "private": true,
  "description": "Provider adapters for acentric LLM: request and response mapping per API format, provider profiles, extractors, the model catalog. Uses only fetch.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "source": "./src/helpers.ts",
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acentric-llm/contracts": "workspace:*"
  }
}
